# agent-inbox: generated wake hook; carries this machine's interpreter path. Never commit.
/.codex/hooks.json

# Secrets
.env

# agent-inbox: per-machine wake state (what was announced, who is waiting). Never commit.
/.agent-mailbox-seen*.json

# agent-inbox: per-machine wake state (what was announced, who is waiting). Never commit.
/.agent-mailbox-wake*.lock

# agent-inbox: identity and possibly a device token. Never commit.
agent-inbox.toml

# Claude Code: per-machine settings and hooks (e.g. the agent-inbox wake hook). Never commit.
.claude/settings.json
.claude/settings.local.json

# Music auditions: large trial renders, kept on disk only until a take is chosen.
music/auditions/

# Python bytecode from music tools
__pycache__/
# Profiler runs written by `npm run profile` (#734)
profiles/
